{
  "name": "atomi-whatsapp",
  "interface": {
    "displayName": "עסק אטומי",
    "shortDescription": "WhatsApp + ElevenLabs. מפתחות ב-.env של הפרויקט. Node.js בלבד."
  },
  "plugins": [
    {
      "name": "whatsapp",
      "source": { "source": "local", "path": "./plugins/whatsapp" },
      "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
      "category": "Productivity"
    },
    {
      "name": "elevenlabs",
      "source": { "source": "local", "path": "./plugins/elevenlabs" },
      "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
      "category": "Productivity"
    }
  ]
}
